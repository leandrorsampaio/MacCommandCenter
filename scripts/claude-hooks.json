{
  "_comment": "Claude Code hooks that report into Mac Command Center's control API. Merge into ~/.claude/settings.json, or run scripts/install-claude-hooks.sh. Every call is best-effort: '|| true' keeps a closed panel from failing the hook, and '-m 2' keeps a wedged socket from hanging the session.",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 2 -H 'X-MCC-Client: 1' 'http://127.0.0.1:8787/v1/signals/claude.waiting?label=Waiting&ttl=1800' >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 2 -H 'X-MCC-Client: 1' 'http://127.0.0.1:8787/v1/signals/claude.done?label=Done&ttl=1800' >/dev/null 2>&1 || true; curl -sS -m 2 -H 'X-MCC-Client: 1' 'http://127.0.0.1:8787/v1/signals/claude.waiting?clear=1' >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 2 -H 'X-MCC-Client: 1' 'http://127.0.0.1:8787/v1/signals/claude.agent?label=Agent&ttl=900' >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 2 -H 'X-MCC-Client: 1' 'http://127.0.0.1:8787/v1/signals/claude.waiting?clear=1' >/dev/null 2>&1 || true; curl -sS -m 2 -H 'X-MCC-Client: 1' 'http://127.0.0.1:8787/v1/signals/claude.done?clear=1' >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
