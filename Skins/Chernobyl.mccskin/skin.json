  "fonts": {
    "display": { "family": "PT Sans", "size": 11, "weight": "bold" },
    "readout": { "family": "PT Mono", "size": 12, "monospaced": true },
    "body": { "family": "PT Sans", "size": 10 }
  },

  "effects": {
    "glow": true,
    "scanlines": false,
    "visualizer": true,
    "uppercase": true
