{
  "format": 1,
  "id": "reactor",
  "name": "Пульт · Control Panel",
  "author": "Mac Command Center",
  "notes": "Cyrillic labels with English underneath. A config supplies the words; the skin supplies the look.",
  "groups": [
    {
      "id": "power",
      "title": "Питание · Power",
      "commands": [
        {
          "id": "keep-awake",
          "title": "Режим сна · Sleep mode",
          "summary": "Обычный режим сна · Normal sleep settings apply",
          "icon": "cup.and.saucer.fill",
          "options": [
            {
              "id": "display-on",
              "title": "Экран вкл",
              "subtitle": "Screen on · nothing sleeps",
              "icon": "sun.max.fill",
              "action": { "type": "keepAwake", "mode": "systemAndDisplay" }
            },
            {
              "id": "display-off",
              "title": "Экран выкл",
              "subtitle": "Screen off · Mac stays awake",
              "icon": "moon.zzz.fill",
              "action": { "type": "keepAwake", "mode": "systemOnly" }
            }
          ]
        }
      ]
    },
    {
      "id": "control",
      "title": "Аварийная защита · Emergency protection",
      "commands": [
        {
          "id": "az5",
          "title": "АЗ-5",
          "summary": "Аварийное гашение экрана · Emergency display shutdown",
          "icon": "exclamationmark.octagon.fill",
          "options": [
            {
              "id": "scram",
              "title": "АЗ-5 · Сброс",
              "subtitle": "Scram — blank the display now",
              "icon": "bolt.slash.fill",
              "action": { "type": "shell", "command": "pmset displaysleepnow", "timeout": 10 }
            }
          ]
        }
      ]
    }
  ]
}
